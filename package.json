{
  "name": "markdown-lite",
  "version": "1.4.2",
  "description": "一个很小、零依赖的 Markdown 解析器：标题、段落、列表、强调和行内代码。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && echo \"✓ built\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["markdown", "parser", "tiny"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
